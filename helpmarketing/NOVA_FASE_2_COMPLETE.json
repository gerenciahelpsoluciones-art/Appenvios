{
  "name": "NOVA - FASE 2 (Voz, Catálogo & CRM Sync)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Reloj (30s)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "table": "mkt_telegram_inbound",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "key": "status",
              "operator": "equal",
              "value": "pending"
            }
          ]
        }
      },
      "id": "read-msgs",
      "name": "Leer Mensajes",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "batch",
      "name": "Uno a Uno",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "table": "productos",
        "returnAll": false,
        "limit": 50,
        "options": {}
      },
      "id": "get-catalog",
      "name": "Cargar Catálogo",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [600, 150]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.raw_message.message.voice ? true : false}}",
              "value2": true
            }
          ]
        }
      },
      "id": "is-voice",
      "name": "Es Voz?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "operation": "getFile",
        "fileId": "={{$node[\"Uno a Uno\"].json.raw_message.message.voice.file_id}}"
      },
      "id": "get-file",
      "name": "Get File Info",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1000, 450]
    },
    {
      "parameters": {
        "url": "={{'https://api.telegram.org/file/bot8700524651:AAH6-G5Rho6YLJcr0uHAKjmqfnGvvHTIQ40/' + $json.result.file_path}}",
        "responseFormat": "file",
        "options": {}
      },
      "id": "download",
      "name": "Download Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=AIzaSyDpNCD35_OYUSJk6UwlaOaFXH8aDzSuaa8",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "=[{ \"parts\": [{ \"text\": \"Eres NOVA. Tu catálogo es: {{ $node['Cargar Catálogo'].json.nombre }}. Extrae cliente e ítems de este audio. Mapea los productos al catálogo si existen. Responde SOLO un JSON: { 'tipo': 'cotizacion', 'cliente': '...', 'items': [{ 'nombre': '...', 'cantidad': X, 'precio': Y, 'id': '...' }] }\" }, { \"inline_data\": { \"mime_type\": \"audio/ogg\", \"data\": \"{{$binary.data.data}}\" } }] }]"
            }
          ]
        },
        "options": {}
      },
      "id": "gemini-voice",
      "name": "Gemini (Voz)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=AIzaSyDpNCD35_OYUSJk6UwlaOaFXH8aDzSuaa8",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "=[{ \"parts\": [{ \"text\": \"Eres NOVA. Tu catálogo es: {{ $node['Cargar Catálogo'].json.nombre }}. Extrae cliente e ítems de este texto: {{$node['Uno a Uno'].json.raw_message.message.text}}. Mapea los productos al catálogo si existen. Responde SOLO un JSON: { 'tipo': 'cotizacion', 'cliente': '...', 'items': [{ 'nombre': '...', 'cantidad': X, 'precio': Y, 'id': '...' }] }\" }] }]"
            }
          ]
        },
        "options": {}
      },
      "id": "gemini-text",
      "name": "Gemini (Texto)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 150]
    },
    {
      "parameters": {
        "value": "={{JSON.parse($json.candidates[0].content.parts[0].text.replace(/```json|```/g, ''))}}",
        "dataPropertyName": "parsed"
      },
      "id": "parse-json",
      "name": "Parse Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1700, 300]
    },
    {
      "parameters": {
        "table": "mkt_cotizaciones",
        "fieldsToInsert": {
          "fields": [
            { "field": "telegram_id", "value": "={{$node[\"Uno a Uno\"].json.telegram_id}}" },
            { "field": "cliente_nombre", "value": "={{$json.parsed.cliente}}" },
            { "field": "estado", "value": "Borrador" }
          ]
        }
      },
      "id": "insert-header",
      "name": "Sync CRM (Header)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1900, 300]
    },
    {
      "parameters": {
        "fieldToSplit": "parsed.items",
        "options": {
          "destinationFieldName": "item"
        }
      },
      "id": "split-items",
      "name": "Split Items",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [2100, 300]
    },
    {
      "parameters": {
        "table": "mkt_cotizacion_detalles",
        "fieldsToInsert": {
          "fields": [
            { "field": "cotizacion_id", "value": "={{$node[\"Sync CRM (Header)\"].json.id}}" },
            { "field": "producto_nombre", "value": "={{$json.item.nombre}}" },
            { "field": "producto_id", "value": "={{$json.item.id}}" },
            { "field": "cantidad", "value": "={{$json.item.cantidad}}" },
            { "field": "precio_unitario", "value": "={{$json.item.precio}}" }
          ]
        }
      },
      "id": "insert-details",
      "name": "Sync CRM (Details)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2300, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "mkt_telegram_inbound",
        "id": "={{$node[\"Uno a Uno\"].json.id}}",
        "fields": {
          "status": "done"
        }
      },
      "id": "mark-done",
      "name": "Finalizar",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2500, 300]
    },
    {
      "parameters": {
        "chatId": "={{$node[\"Uno a Uno\"].json.telegram_id}}",
        "text": "=✅ *¡Cotización Sincronizada!*\n\n*Cliente:* {{$node[\"Parse Result\"].json.parsed.cliente}}\n*Ítems:* {{$node[\"Parse Result\"].json.parsed.items.length}}\n\nNOVA ha procesado tu solicitud y la ha guardado en el CRM como borrador.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "reply",
      "name": "Responder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [2700, 300]
    }
  ],
  "connections": {
    "trigger": { "main": [[{ "node": "read-msgs", "type": "main", "index": 0 }]] },
    "read-msgs": { "main": [[{ "node": "batch", "type": "main", "index": 0 }]] },
    "batch": { "main": [[{ "node": "get-catalog", "type": "main", "index": 0 }]] },
    "get-catalog": { "main": [[{ "node": "is-voice", "type": "main", "index": 0 }]] },
    "is-voice": { "main": [[{ "node": "gemini-text", "type": "main", "index": 0 }], [{ "node": "get-file", "type": "main", "index": 0 }]] },
    "get-file": { "main": [[{ "node": "download", "type": "main", "index": 0 }]] },
    "download": { "main": [[{ "node": "gemini-voice", "type": "main", "index": 0 }]] },
    "gemini-voice": { "main": [[{ "node": "parse-json", "type": "main", "index": 0 }]] },
    "gemini-text": { "main": [[{ "node": "parse-json", "type": "main", "index": 0 }]] },
    "parse-json": { "main": [[{ "node": "insert-header", "type": "main", "index": 0 }]] },
    "insert-header": { "main": [[{ "node": "split-items", "type": "main", "index": 0 }]] },
    "split-items": { "main": [[{ "node": "insert-details", "type": "main", "index": 0 }]] },
    "insert-details": { "main": [[{ "node": "mark-done", "type": "main", "index": 0 }]] },
    "mark-done": { "main": [[{ "node": "reply", "type": "main", "index": 0 }]] }
  }
}
