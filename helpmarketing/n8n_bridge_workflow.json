{
  "name": "HelpMarketing - Telegram BRIDGE (No Tunnel)",
  "nodes": [
    {
      "parameters": {
        "event": "inserted",
        "schema": "public",
        "table": "mkt_telegram_inbound",
        "options": {}
      },
      "id": "supabase-trigger",
      "name": "Supabase Trigger",
      "type": "n8n-nodes-base.supabaseTrigger",
      "typeVersion": 1,
      "position": [100, 240]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "prompt": "={{$json.raw_message.message.text}}",
        "systemMessage": "Eres el Cerebro de Extracción de Cotizaciones para Help Soluciones.\nAnaliza el mensaje de Telegram y extrae: Cliente, Items (descripcion, cantidad, precio_sugerido), Observaciones.\nResponde ÚNICAMENTE con un objeto JSON válido.",
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "gemini-extract",
      "name": "Gemini Extract",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [350, 240]
    },
    {
      "parameters": {
        "tableId": "cotizaciones",
        "fieldsToInsert": {
          "fields": [
            { "field": "comprador_nombre", "value": "={{$node[\"Gemini Extract\"].json.output.cliente}}" },
            { "field": "estado", "value": "borrador" },
            { "field": "validez_oferta", "value": 3 }
          ]
        }
      },
      "id": "create-quote-header",
      "name": "Create Quote Header",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [580, 240]
    },
    {
      "parameters": {
        "fieldToSplitOut": "={{$node[\"Gemini Extract\"].json.output.items}}",
        "options": {}
      },
      "id": "split-items",
      "name": "Split Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [800, 240]
    },
    {
      "parameters": {
        "tableId": "cotizacion_detalles",
        "fieldsToInsert": {
          "fields": [
            { "field": "cotizacion_id", "value": "={{$node[\"Create Quote Header\"].json.id}}" },
            { "field": "descripcion", "value": "={{$json.descripcion}}" },
            { "field": "cantidad", "value": "={{$json.cantidad}}" },
            { "field": "precio_unitario", "value": "={{$json.precio_sugerido || 0}}" }
          ]
        }
      },
      "id": "insert-details",
      "name": "Insert Details",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1020, 240]
    },
    {
      "parameters": {
        "chatId": "={{$node[\"Supabase Trigger\"].json.raw_message.message.chat.id}}",
        "text": "=✅ *Cotización Procesada!*\n\n*Cliente:* {{$node[\"Gemini Extract\"].json.output.cliente}}\n*Ítems:* {{$node[\"Gemini Extract\"].json.output.items.length}}\n\nLa cotización ya está disponible en el CRM.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-reply",
      "name": "Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1250, 240]
    },
    {
      "parameters": {
        "tableId": "mkt_telegram_inbound",
        "updateKey": "id",
        "dataToUpdate": {
          "fields": [
            { "field": "status", "value": "done" }
          ]
        },
        "options": {}
      },
      "id": "mark-as-done",
      "name": "Mark as Done",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1480, 240]
    }
  ],
  "connections": {
    "Supabase Trigger": { "main": [[{ "node": "Gemini Extract", "type": "main", "index": 0 }]] },
    "Gemini Extract": { "main": [[{ "node": "create-quote-header", "type": "main", "index": 0 }]] },
    "create-quote-header": { "main": [[{ "node": "split-items", "type": "main", "index": 0 }]] },
    "split-items": { "main": [[{ "node": "insert-details", "type": "main", "index": 0 }]] },
    "insert-details": { "main": [[{ "node": "telegram-reply", "type": "main", "index": 0 }]] },
    "telegram-reply": { "main": [[{ "node": "mark-as-done", "type": "main", "index": 0 }]] }
  }
}
