{
  "name": "NOVA - SISTEMA COMPLETO (Final)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "1",
      "name": "Reloj (30s)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "table": "mkt_telegram_inbound",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "key": "processed",
              "operator": "equal",
              "value": false
            }
          ]
        }
      },
      "id": "2",
      "name": "Leer Mensajes",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "3",
      "name": "Procesar Uno a Uno",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=AIzaSyDpNCD35_OYUSJk6UwlaOaFXH8aDzSuaa8",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "=[{ \"parts\": [{ \"text\": \"Eres NOVA, la asistente de HelpMarketing. Responde de forma amable y profesional a este mensaje del usuario: {{ $json.payload.message.text }}. Si quiere cotizar, pregúntale por el cliente. Si quiere crear un producto, pregúntale los campos uno a uno.\" }] }]"
            }
          ]
        },
        "options": {}
      },
      "id": "5",
      "name": "NOVA AI (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "mkt_telegram_inbound",
        "id": "={{ $node[\"Leer Mensajes\"].json.id }}",
        "fields": {
          "processed": true
        }
      },
      "id": "6",
      "name": "Marcar Procesado",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot8700524651:AAH6-G5Rho6YLJcr0uHAKjmqfnGvvHTIQ40/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $node[\"Leer Mensajes\"].json.payload.message.from.id }}"
            },
            {
              "name": "text",
              "value": "={{ $json.candidates[0].content.parts[0].text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7",
      "name": "Enviar a Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1400, 300]
    }
  ],
  "connections": {
    "1": { "main": [[{ "node": "2", "type": "main", "index": 0 }]] },
    "2": { "main": [[{ "node": "3", "type": "main", "index": 0 }]] },
    "3": { "main": [[{ "node": "5", "type": "main", "index": 0 }]] },
    "5": { "main": [[{ "node": "6", "type": "main", "index": 0 }]] },
    "6": { "main": [[{ "node": "7", "type": "main", "index": 0 }]] }
  }
}
